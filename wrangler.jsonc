{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lfown",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Unknown paths get public/404.html with a 404 status. The status matters: the
    // worker's section loop tells "no such asset" from "here it is" by reading it,
    // and a 200 would make every unknown coin page serve the dead end instead of
    // the shell that looks the coin up on chain.
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      // Uploaded images and the token metadata JSON beside them. These live in R2,
      // never in ./public, so the assets handler has nothing to match and would
      // answer every one of them with the 404 page above rather than falling
      // through — which is what it did, killing every token image on the site and
      // every metadata document already written on chain.
      "/i/*",
      "/launch",
      "/launch/*",
      "/coins",
      "/coins/*",
      "/creator",
      "/creator/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "*/10 * * * *",
      "0 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "REGISTRY",
      "id": "aabec81bd50b44e1b78a9c18fd878de5",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "lfown-images",
      "remote": true
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://letsfuckingown.fun"
  },
  // Per-address ceilings on what costs something to answer, enforced by the Worker
  // itself. The RPC proxy has its own because a trade polls it every second while a
  // signature lands; the heavy routes (chart, launch, exit, graduate, image,
  // metadata) share the other. A zone WAF rule on /api/* is the layer above these.
  // `period` may only be 10 or 60.
  "ratelimits": [
    { "name": "RPC_LIMITER", "namespace_id": "1001", "simple": { "limit": 200, "period": 60 } },
    { "name": "HEAVY_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "routes": [
    {
      "pattern": "letsfuckingown.fun",
      "custom_domain": true
    },
    {
      "pattern": "www.letsfuckingown.fun",
      "custom_domain": true
    }
  ]
}
